POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow
POSTGRES_DB=stockflow
DATABASE_URL=postgresql+psycopg://stockflow:stockflow@postgres:5432/stockflow

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

FIRST_ADMIN_EMAIL=admin@stockflow.com
FIRST_ADMIN_PASSWORD=change-me

CORS_ORIGINS=http://localhost:5173

# "log" (default) just logs would-be emails, never sends real mail - safe for local dev.
# Switch to "smtp" and fill in the smtp_* values below to actually send notifications.
EMAIL_BACKEND=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@stockflow.local
